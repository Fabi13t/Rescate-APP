<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_green"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHello"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hola 👋"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:text="Los Olivos, Lima"
                            android:textColor="@color/white_70"
                            android:textSize="13sp"
                            app:drawableStartCompat="@drawable/ic_place"
                            app:drawableTint="@color/white_70" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnBell"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_glass"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/ivBell"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Notificaciones"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/white" />

                        <View
                            android:id="@+id/bellDot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="11dp"
                            android:background="@drawable/bg_badge_amber"
                            android:backgroundTint="@color/amber" />
                    </FrameLayout>
                </LinearLayout>

                
                <LinearLayout
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_search"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/ink_muted" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Buscar packs o comercios"
                        android:textColor="@color/ink_soft"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_box"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/green_800" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedChip="@+id/chipAll"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Todos" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBakery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥖  Panadería" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGrocery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥕  Abarrotes" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrepared"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍲  Preparados" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImpact"
                style="@style/Widget.Rescate.Card.Mint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/screen_padding"
                android:stateListAnimator="@animator/press_scale">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_box"
                        android:layout_height="@dimen/icon_box"
                        android:background="@drawable/bg_circle_white"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_eco"
                        app:tint="@color/green_600" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Impacto de esta semana"
                            android:textColor="@color/green_900"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvImpact"
                            style="@style/Text.Rescate.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.2 kg rescatados · 3 packs comprados" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/green_700" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="@dimen/screen_padding"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSection"
                    style="@style/Text.Rescate.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Packs cerca de ti" />

                <TextView
                    android:id="@+id/tvSeeMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="Ver mapa ›"
                    android:textColor="@color/green_700"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_pack_skeleton" />

                    <include layout="@layout/item_pack_skeleton" />

                    <include layout="@layout/item_pack_skeleton" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPacks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/layout_list_enter"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDonate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/screen_padding"
                android:layout_marginBottom="24dp"
                android:stateListAnimator="@animator/press_scale"
                app:cardBackgroundColor="@color/amber_bg"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="@dimen/icon_box"
                        android:layout_height="@dimen/icon_box"
                        android:background="@drawable/bg_circle_white"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_gift"
                        app:tint="@color/amber" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿Te sobra comida en casa?"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Text.Rescate.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dónala a familias y comedores de tu zona." />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/amber" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
