<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Rescate.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Procesando tu reserva" />

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@anim/fade_up"
        android:outAnimation="@anim/fade_out">

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                android:id="@+id/lastUnitCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_amber"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_white"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/amber" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Pack reservado para ti!"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBannerBody"
                        style="@style/Text.Rescate.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Panadería Don Pedro · Solo queda 1 pack" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Rescate.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Tiempo restante para pagar"
                android:textColor="@color/ink_muted" />

            <FrameLayout
                android:id="@+id/timerBox"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="18dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/timerRing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="180"
                    android:progress="180"
                    app:indicatorColor="@color/green_600"
                    app:indicatorSize="232dp"
                    app:trackColor="@color/mint_100"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="14dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="03:00"
                        android:textColor="@color/green_900"
                        android:textSize="52sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Rescate.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="minutos : segundos" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                style="@style/Text.Rescate.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Tu pack queda retenido durante 3 minutos.\nPaga con Yape y registra tu operación para que el comercio la valide."
                android:textSize="14sp" />
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageView
                android:id="@+id/ivExpired"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_badge_red"
                android:importantForAccessibility="no"
                android:padding="32dp"
                android:src="@drawable/ic_schedule"
                app:tint="@color/red" />

            <TextView
                style="@style/Text.Rescate.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tiempo agotado" />

            <TextView
                style="@style/Text.Rescate.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Pasaron los 3 minutos y el pack se liberó\npara otros vecinos. Puedes intentarlo de nuevo."
                android:textSize="14sp" />
        </LinearLayout>
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPay"
            style="@style/Widget.Rescate.Button.Yape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continuar a pago por Yape" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Rescate.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancelar reserva" />
    </LinearLayout>
</LinearLayout>
