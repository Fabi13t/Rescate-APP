<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/successHalo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_circle_mint">

        <ImageView
            android:id="@+id/ivSuccess"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/avd_success" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvSuccessTitle"
        style="@style/Text.Rescate.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="¡Listo!" />

    <TextView
        android:id="@+id/tvSuccessBody"
        style="@style/Text.Rescate.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="15sp"
        android:text="" />
</LinearLayout>
