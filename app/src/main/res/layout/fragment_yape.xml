<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Rescate.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Pagar con Yape">

        <TextView
            android:id="@+id/chipTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_badge_amber"
            android:drawablePadding="4dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="02:45"
            android:textColor="@color/amber"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_schedule"
            app:drawableTint="@color/amber" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@anim/fade_up"
        android:outAnimation="@anim/fade_out">

        
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <LinearLayout
                    android:id="@+id/yapeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_yape"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_yape"
                        android:gravity="center"
                        android:text="Y"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.Rescate.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Yapea a" />

                    <TextView
                        android:id="@+id/tvMerchant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Panadería Don Pedro"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvYapeNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="987 654 321"
                            android:textColor="@color/yape"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCopy"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Copiar número"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/yape" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card_white"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:text="Monto: S/ 6.00"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenYape"
                        style="@style/Widget.Rescate.Button.Yape"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Abrir Yape" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Rescate.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Antes de continuar" />

                <TextView
                    style="@style/Text.Rescate.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="8dp"
                    android:text="1.  Yapea el monto exacto al número del comercio.\n2.  Revisa que Yape indique «¡Yapeaste!».\n3.  Copia el número de operación y regístralo aquí." />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOperation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="Número de operación Yape"
                    app:counterEnabled="true"
                    app:counterMaxLength="8"
                    app:helperText="Lo encuentras en la constancia de Yape."
                    app:startIconDrawable="@drawable/ic_qr">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOperation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="8" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_yape"
                    android:padding="14dp"
                    android:text="Importante: la app no realiza cobros automáticos. El comercio verifica tu pago en su Yape antes de entregarte el pack."
                    android:textColor="@color/yape"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    app:indicatorColor="@color/yape"
                    app:indicatorSize="120dp"
                    app:trackColor="@color/yape_bg"
                    app:trackThickness="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Y"
                    android:textColor="@color/yape"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                style="@style/Text.Rescate.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pago en revisión" />

            <TextView
                android:id="@+id/tvReviewBody"
                style="@style/Text.Rescate.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="El comercio está verificando tu operación.\nEsto suele tomar menos de un minuto."
                android:textSize="14sp" />
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_badge_red"
                android:importantForAccessibility="no"
                android:padding="30dp"
                android:src="@drawable/ic_close"
                app:tint="@color/red" />

            <TextView
                style="@style/Text.Rescate.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pago rechazado" />

            <TextView
                android:id="@+id/tvRejectedBody"
                style="@style/Text.Rescate.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="El comercio no encontró tu operación en su Yape.\nSi ya pagaste, comunícate con el comercio."
                android:textSize="14sp" />
        </LinearLayout>
    </ViewFlipper>

    <FrameLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar pago" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/white"
            app:indicatorSize="26dp"
            app:trackThickness="3dp" />
    </FrameLayout>
</LinearLayout>
