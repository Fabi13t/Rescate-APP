<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvCounter"
        style="@style/Text.Rescate.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="01 / 03" />

    <FrameLayout
        android:id="@+id/illustration"
        android:layout_width="260dp"
        android:layout_height="260dp">

        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_mint" />

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/onboarding_rescata" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Text.Rescate.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="Evita el desperdicio" />

    <TextView
        android:id="@+id/tvBody"
        style="@style/Text.Rescate.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:textSize="15sp"
        android:text="Descubre packs de alimentos en comercios cerca de tu ubicación." />
</LinearLayout>
