<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Rescate.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Donar alimentos" />

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@anim/slide_in_right"
        android:outAnimation="@anim/slide_out_left">

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <FrameLayout
                android:id="@+id/introIllustration"
                android:layout_width="240dp"
                android:layout_height="240dp">

                <View
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_mint" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/donar_intro" />
            </FrameLayout>

            <TextView
                style="@style/Text.Rescate.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Dona lo que ya no usarás" />

            <TextView
                style="@style/Text.Rescate.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Conecta tus excedentes con familias\ny comedores de tu comunidad."
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card_mint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_white"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_eco"
                    app:tint="@color/green_600" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Donación responsable: perecibles con vencimiento máximo de 7 días."
                    android:textColor="@color/green_900"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="¿Qué vas a donar?"
                    app:helperText="Ej.: Panes del día, arroz y menestras">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Text.Rescate.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Tipo de alimento" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:checkedChip="@+id/chipPerishable"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPerishable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perecible" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNonPerishable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No perecible" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCooked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comida preparada" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Rescate.Overline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cantidad aproximada" />

                    <TextView
                        android:id="@+id/tvKg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 kg"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderKg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="3"
                    android:valueFrom="1"
                    android:valueTo="20" />

                <TextView
                    style="@style/Text.Rescate.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="¿En cuántos días vence?" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <TextView
                    android:id="@+id/tvExpiryHint"
                    style="@style/Text.Rescate.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Los perecibles deben vencer en 7 días o menos." />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDistrict"
                    style="@style/Widget.Rescate.TextInput.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Distrito de recojo"
                    app:startIconDrawable="@drawable/ic_place">

                    <AutoCompleteTextView
                        android:id="@+id/acDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:padding="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Notas para quien recoge (opcional)"
                    app:counterEnabled="true"
                    app:counterMaxLength="140">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="140"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/Text.Rescate.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revisa tu publicación" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="8dp"
                    android:padding="16dp"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/screen_padding">

            <include
                android:id="@+id/success"
                layout="@layout/view_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear una donación" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/white"
                app:indicatorSize="26dp"
                app:trackThickness="3dp" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondary"
            style="@style/Widget.Rescate.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Ver mis donaciones" />
    </LinearLayout>
</LinearLayout>
