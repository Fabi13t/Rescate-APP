<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            
            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="@drawable/bg_header_green">

                <View
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:alpha="0.12"
                    android:background="@drawable/bg_circle_white" />

                <ImageView
                    android:id="@+id/ivHeroIcon"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shopping_bag"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/ivHeroPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="Volver"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavorite"
                    style="@style/Widget.Rescate.Button.Light"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:minHeight="44dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:text="Guardar"
                    android:textSize="13sp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_favorite_border"
                    app:iconSize="18dp"
                    app:iconTint="@color/red" />

                <TextView
                    android:id="@+id/tvDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_badge_amber"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="-60% de descuento"
                    android:textColor="@color/amber"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStore"
                        style="@style/Text.Rescate.Display"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Panadería Don Pedro" />

                    <TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="2dp"
                        android:gravity="center_vertical"
                        android:text="4.6"
                        android:textColor="@color/ink"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_star"
                        app:drawableTint="@color/amber" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Panadería · 350 m"
                    android:textColor="@color/green_700"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAddress"
                    style="@style/Text.Rescate.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="Av. Los Olivos 234, Lima"
                    app:drawableStartCompat="@drawable/ic_place"
                    app:drawableTint="@color/ink_soft" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="@color/outline" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/Text.Rescate.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pack sorpresa" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/Text.Rescate.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="14sp"
                    android:text="Selección de alimentos del día, próximos a vencer, en buenas condiciones." />

                
                <LinearLayout
                    android:id="@+id/stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_white"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/Text.Rescate.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Normal"
                            android:textColor="@color/ink_muted" />

                        <TextView
                            android:id="@+id/tvNormal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="S/ 15.00"
                            android:textColor="@color/ink_muted"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_mint"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/Text.Rescate.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rescate" />

                        <TextView
                            android:id="@+id/tvRescue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="S/ 6.00"
                            android:textColor="@color/green_800"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_white"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/Text.Rescate.Overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disponible"
                            android:textColor="@color/ink_muted" />

                        <TextView
                            android:id="@+id/tvStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="4 packs"
                            android:textColor="@color/ink"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/stockBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    app:indicatorColor="@color/green_600"
                    app:trackColor="@color/mint_100"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/tvStockHint"
                    style="@style/Text.Rescate.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Quedan 4 de 6 packs" />

                
                <LinearLayout
                    android:id="@+id/expiryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_amber"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_schedule"
                        app:tint="@color/amber" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPickup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recoge hoy hasta las 20:30"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvExpiry"
                            style="@style/Text.Rescate.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Vence hoy · Perecible, consumir pronto" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDirections"
                    style="@style/Widget.Rescate.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Cómo llegar"
                    app:icon="@drawable/ic_directions"
                    app:iconGravity="textStart"
                    app:iconTint="@color/green_800" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Rescate.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio rescate" />

            <TextView
                android:id="@+id/tvBottomPrice"
                style="@style/Text.Rescate.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 6.00" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReserve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reservar pack" />
    </LinearLayout>
</LinearLayout>
