<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        style="@style/Text.Rescate.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filtros de búsqueda" />

    <TextView
        style="@style/Text.Rescate.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Personaliza lo que se muestra en tu lista." />

    <TextView
        style="@style/Text.Rescate.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Categorías" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/fAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Todas" />

        <com.google.android.material.chip.Chip
            android:id="@+id/fBakery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panadería" />

        <com.google.android.material.chip.Chip
            android:id="@+id/fGrocery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abarrotes" />

        <com.google.android.material.chip.Chip
            android:id="@+id/fPrepared"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preparados" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Rescate.Overline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Distancia máxima" />

        <TextView
            android:id="@+id/tvKm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 km"
            android:textColor="@color/ink"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderKm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:value="5"
        android:valueFrom="1"
        android:valueTo="10" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Rescate.Overline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Precio hasta" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/ 30"
            android:textColor="@color/ink"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:value="30"
        android:valueFrom="5"
        android:valueTo="30" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="Solo con stock disponible"
        android:textColor="@color/ink"
        app:thumbTint="@color/white"
        app:trackTint="@color/selector_switch_track" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Rescate.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="Limpiar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Aplicar filtros" />
    </LinearLayout>
</LinearLayout>
