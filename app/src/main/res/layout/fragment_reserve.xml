<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Rescate.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Reservar pack" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                android:id="@+id/storeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_mint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivCategory"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_pack_image"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_shopping_bag"
                    app:tint="@color/green_800" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green_900"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPackInfo"
                        style="@style/Text.Rescate.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Rescate.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Detalles de la reserva" />

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cantidad"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvMax"
                        style="@style/Text.Rescate.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Máximo 4" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMinus"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Quitar uno"
                    app:icon="@drawable/ic_remove"
                    app:iconTint="@color/green_800" />

                <TextView
                    android:id="@+id/tvQty"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Agregar uno"
                    app:backgroundTint="@color/green_800"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <include
                android:id="@+id/rowPickup"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowAddress"
                layout="@layout/view_info_row" />

            <include
                android:id="@+id/rowMethod"
                layout="@layout/view_info_row" />

            <LinearLayout
                android:id="@+id/totalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_mint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total a pagar"
                        android:textColor="@color/green_900"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSaving"
                        style="@style/Text.Rescate.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ahorras S/ 9.00" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 6.00"
                    android:textColor="@color/green_800"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/Text.Rescate.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawablePadding="8dp"
                android:text="Al continuar, reservamos tu pack por 3 minutos para que pagues con Yape sin que nadie te lo gane."
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/ink_soft" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continuar con la reserva" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:elevation="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/white"
            app:indicatorSize="26dp"
            app:trackThickness="3dp" />
    </FrameLayout>
</LinearLayout>
