<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        style="@style/Text.Rescate.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="20dp"
        android:text="Pagos por Yape" />

    <TextView
        style="@style/Text.Rescate.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:text="Gestiona los pagos reportados por tus clientes" />

    <LinearLayout
        android:id="@+id/yapeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_card_yape"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_yape"
            android:gravity="center"
            android:text="Y"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Rescate.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medio de cobro" />

            <TextView
                android:id="@+id/tvYape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yape · 987 654 321"
                android:textColor="@color/yape"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfigYape"
            style="@style/Widget.Rescate.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar"
            android:textColor="@color/yape" />
    </LinearLayout>

    <TextView
        style="@style/Text.Rescate.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="18dp"
        android:text="Movimientos recientes" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_list_enter"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding"
        android:background="@drawable/bg_card_yape"
        android:drawablePadding="10dp"
        android:padding="12dp"
        android:text="Valida cada pago con el registro real de tu Yape antes de entregar el pack."
        android:textColor="@color/yape"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_info"
        app:drawableTint="@color/yape" />
</LinearLayout>
