<?xml version="1.0" encoding="utf-8"?>
<resources>

    
    <style name="Widget.Rescate.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="backgroundTint">@color/selector_button_bg</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Rescate.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/green_800</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="Widget.Rescate.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_700</item>
    </style>

    <style name="Widget.Rescate.Button.Danger" parent="Widget.Rescate.Button">
        <item name="backgroundTint">@color/red</item>
    </style>

    <style name="Widget.Rescate.Button.Light" parent="Widget.Rescate.Button">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/green_800</item>
    </style>

    <style name="Widget.Rescate.Button.Yape" parent="Widget.Rescate.Button">
        <item name="backgroundTint">@color/yape</item>
    </style>

    
    <style name="Widget.Rescate.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_s</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/green_700</item>
        <item name="startIconTint">@color/ink_muted</item>
        <item name="endIconTint">@color/ink_muted</item>
    </style>

    <style name="Widget.Rescate.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_s</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_s</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/green_700</item>
    </style>

    
    <style name="Widget.Rescate.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">38dp</item>
        <item name="android:textSize">13sp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
    </style>

    
    <style name="Widget.Rescate.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Rescate.Card.Mint" parent="Widget.Rescate.Card">
        <item name="cardBackgroundColor">@color/mint_100</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Rescate.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/green_700</item>
        <item name="trackColorInactive">@color/mint_200</item>
        <item name="thumbColor">@color/green_800</item>
        <item name="haloColor">@color/mint_200</item>
        <item name="labelBehavior">gone</item>
    </style>

    
    <style name="Text.Rescate.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Rescate.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text.Rescate.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Text.Rescate.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Rescate.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Rescate.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/green_700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Rescate.Price" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/green_800</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    
    <style name="Text.Rescate.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    
    <style name="Rescate.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawableTint">@color/green_700</item>
        <item name="drawableTint">@color/green_700</item>
    </style>

    <style name="Rescate.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="navigationIcon">@drawable/ic_arrow_back</item>
        <item name="titleTextAppearance">@style/Text.Rescate.Title</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>

    <style name="Rescate.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/selector_nav</item>
        <item name="itemTextColor">@color/selector_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Rescate.NavIndicator</item>
        <item name="itemTextAppearanceActive">@style/Rescate.NavText</item>
        <item name="itemTextAppearanceInactive">@style/Rescate.NavText</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Rescate.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/mint_100</item>
    </style>

    <style name="Rescate.NavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
